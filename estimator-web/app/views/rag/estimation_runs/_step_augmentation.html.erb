<% view = run.augmentation_view %>
<% retrieval = run.retrieval_view %>

<h2 class="text-lg font-bold tracking-tight text-white mb-1">3 · Augmentation — ensamblaje del contexto</h2>
<p class="text-white/50 text-sm mb-5">
  Los chunks se envuelven en delimitadores <code class="text-white/80">&lt;source&gt;</code> con su
  <code class="text-white/80">id</code> y metadata — así el modelo sabe qué citar. Se trunca a chunk
  completo dentro del presupuesto de tokens, nunca a mitad.
</p>

<% if retrieval.nil? || retrieval.soft_fail? %>
  <div class="p-4 rounded-md bg-brand/15 border border-brand text-brand-soft">
    No hay chunks recuperados. Vuelve a <%= link_to "Retrieval", rag_estimation_run_path(run, step: "retrieval"), class: "underline font-bold" %> primero.
  </div>
<% else %>
  <%= form_with url: assemble_rag_estimation_run_path(run), method: :post, local: true,
        class: "flex items-end gap-3 mb-6" do %>
    <div>
      <label class="block text-xs font-bold text-white/70 mb-1">max_context_tokens (opcional)</label>
      <input type="number" name="max_context_tokens" min="256" max="64000"
             placeholder="16384 (default)"
             class="border border-white/20 rounded-md p-2 text-white bg-ink/40 focus:outline-none focus:border-brand w-48">
    </div>
    <button type="submit"
            class="inline-flex items-center px-5 py-2 bg-brand text-ink-dark font-bold tracking-tight rounded-md hover:bg-brand-strong cursor-pointer transition-colors text-sm">
      <%= view ? "Re-ensamblar" : "Ensamblar contexto" %>
    </button>
  <% end %>

  <% if view %>
    <div class="grid grid-cols-2 gap-4 mb-5">
      <div class="p-4 rounded-md bg-ink/30 border border-white/10">
        <div class="text-xs uppercase tracking-tight text-white/50 font-bold">Tokens del contexto</div>
        <div class="text-2xl font-bold tracking-tighter text-white mt-1 tabular-nums"><%= number_with_delimiter(view.token_count) %></div>
      </div>
      <div class="p-4 rounded-md bg-ink/30 border border-white/10">
        <div class="text-xs uppercase tracking-tight text-white/50 font-bold">Chunks descartados por presupuesto</div>
        <div class="text-2xl font-bold tracking-tighter text-white mt-1 tabular-nums">
          <%= view.dropped_count %> <span class="text-base text-white/40">/ <%= view.kept_chunks.size + view.dropped_count %></span>
        </div>
      </div>
    </div>

    <div class="text-xs uppercase tracking-tight text-white/50 font-bold mb-2">Bloque de contexto (XML)</div>
    <pre class="rounded-md border border-white/10 bg-ink/50 p-4 text-xs text-white/80 overflow-x-auto whitespace-pre-wrap"><%= view.context_block %></pre>

    <div class="mt-6">
      <%= link_to "Continuar → Generación", rag_estimation_run_path(run, step: "generation"),
            class: "inline-flex items-center px-5 py-2.5 bg-brand text-ink-dark font-bold tracking-tight rounded-md hover:bg-brand-strong transition-colors text-sm" %>
    </div>
  <% else %>
    <p class="text-white/40 text-sm">Ensambla el contexto para ver el bloque <code>&lt;source&gt;</code>.</p>
  <% end %>
<% end %>
