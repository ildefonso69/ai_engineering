<%#
  One editable task row. locals: m (module index), t (task index), task (TaskItemView | nil).
  Reused both for server-rendered rows and (with __MIDX__/__TIDX__ placeholders)
  inside the <template> the Stimulus editor clones.
%>
<tr data-task data-task-index="<%= t %>" class="align-top">
  <td class="p-2">
    <input type="text" name="modules[<%= m %>][tasks][<%= t %>][name]" value="<%= task&.name %>"
           placeholder="Tarea"
           class="w-full border border-white/15 rounded p-2 text-white bg-ink/40 focus:outline-none focus:border-brand">
  </td>
  <td class="p-2">
    <input type="text" name="modules[<%= m %>][tasks][<%= t %>][description]" value="<%= task&.description %>"
           placeholder="Descripción"
           class="w-full border border-white/15 rounded p-2 text-white/90 bg-ink/40 text-xs focus:outline-none focus:border-brand">
  </td>
  <td class="p-2 w-24">
    <input type="number" min="0" name="modules[<%= m %>][tasks][<%= t %>][engineer_days]"
           value="<%= task ? task.engineer_days : 0 %>"
           data-estimate-days data-action="input->estimate-modules-editor#recompute"
           class="w-full border border-white/15 rounded p-2 text-right text-white bg-ink/40 tabular-nums focus:outline-none focus:border-brand">
  </td>
  <td class="p-2 w-32">
    <input type="text" name="modules[<%= m %>][tasks][<%= t %>][sources]" value="<%= task&.sources_label %>"
           placeholder="ids: 12, 14"
           class="w-full border border-white/15 rounded p-2 text-white bg-ink/40 font-mono text-xs focus:outline-none focus:border-brand">
  </td>
  <td class="p-2 text-center w-10">
    <button type="button" data-action="estimate-modules-editor#deleteTask"
            class="text-white/40 hover:text-brand cursor-pointer font-bold" title="Eliminar tarea">✕</button>
  </td>
</tr>
