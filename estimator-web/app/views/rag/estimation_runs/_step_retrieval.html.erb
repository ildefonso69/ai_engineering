<% view = run.retrieval_view %>
<% query = run.reformulation_view&.query %>
<% sectors = ["finance", "ecommerce", "healthcare", "industrial"] %>
<% applied = view&.filters || {} %>
<% checked_sectors = Array(applied["sectors"]).presence || Array(query&.sector).select { |s| sectors.include?(s) } %>

<h2 class="text-lg font-bold tracking-tight text-white mb-1">2 · Retrieval filtrado</h2>
<p class="text-white/50 text-sm mb-5">
  Tres ejes: <span class="text-white/80">top-K</span> (cuántos), <span class="text-white/80">threshold</span>
  (cómo de cerca) y <span class="text-white/80">filtros estructurales</span> (sobre qué subconjunto).
  Si nada cruza el umbral → soft-fail, y el pipeline no inventa.
</p>

<%= form_with url: retrieve_rag_estimation_run_path(run), method: :post, local: true,
      class: "p-4 rounded-md bg-ink/30 border border-white/10 mb-6",
      data: { controller: "form-loading", action: "submit->form-loading#start" } do %>
  <div class="grid md:grid-cols-3 gap-4">
    <div>
      <label class="block text-xs font-bold text-white/70 mb-1">top_k</label>
      <input type="number" name="top_k" min="1" max="30" value="<%= applied["top_k"] || 10 %>"
             class="w-full border border-white/20 rounded-md p-2 text-white bg-ink/40 focus:outline-none focus:border-brand">
    </div>
    <div>
      <label class="block text-xs font-bold text-white/70 mb-1">distance_threshold</label>
      <input type="number" step="0.01" min="0" max="2" name="distance_threshold"
             value="<%= applied["distance_threshold"] || 0.6 %>"
             class="w-full border border-white/20 rounded-md p-2 text-white bg-ink/40 focus:outline-none focus:border-brand">
    </div>
    <div>
      <label class="block text-xs font-bold text-white/70 mb-1">project_year (min / max)</label>
      <div class="flex gap-2">
        <input type="number" name="project_year_min" placeholder="min" value="<%= applied["project_year_min"] %>"
               class="w-full border border-white/20 rounded-md p-2 text-white bg-ink/40 focus:outline-none focus:border-brand">
        <input type="number" name="project_year_max" placeholder="max" value="<%= applied["project_year_max"] %>"
               class="w-full border border-white/20 rounded-md p-2 text-white bg-ink/40 focus:outline-none focus:border-brand">
      </div>
    </div>
  </div>
  <div class="mt-3">
    <label class="block text-xs font-bold text-white/70 mb-1">sectors</label>
    <div class="flex flex-wrap gap-3">
      <% sectors.each do |sector| %>
        <label class="inline-flex items-center gap-1.5 text-sm text-white/80">
          <%= check_box_tag "sectors[]", sector, checked_sectors.include?(sector), class: "accent-brand" %>
          <%= sector %>
        </label>
      <% end %>
    </div>
  </div>
  <div class="mt-4 flex items-center gap-3">
    <button type="submit" data-form-loading-target="submit"
            class="inline-flex items-center px-5 py-2 bg-brand text-ink-dark font-bold tracking-tight rounded-md hover:bg-brand-strong cursor-pointer transition-colors text-sm">
      <span data-form-loading-target="label"><%= view ? "Re-ejecutar retrieval" : "Ejecutar retrieval" %></span>
      <svg data-form-loading-target="spinner" class="hidden ml-2 h-4 w-4 animate-spin" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
      </svg>
    </button>
    <span data-form-loading-target="statusPanel" class="hidden text-sm text-white/60">
      <span data-form-loading-target="phaseText">Embebiendo y buscando…</span>
      <span class="font-mono text-xs" data-form-loading-target="timer">00:00</span>
    </span>
  </div>
<% end %>

<% if view.nil? %>
  <p class="text-white/40 text-sm">Ejecuta el retrieval para ver los chunks recuperados.</p>
<% elsif view.soft_fail? %>
  <div class="p-5 rounded-md bg-brand/15 border border-brand text-white">
    <p class="font-bold text-brand mb-1">Soft-fail — contexto insuficiente</p>
    <p class="text-sm text-white/90">
      Ningún presupuesto histórico cruzó el umbral (<%= applied["distance_threshold"] || 0.6 %>) sobre
      <%= view.candidates_evaluated %> candidatos evaluados. Afloja el <code>distance_threshold</code> o
      quita un filtro y vuelve a ejecutar. <span class="text-brand-soft">El pipeline no continúa: prefiere
      decir "no sé" a inventar.</span>
    </p>
  </div>
<% else %>
  <div class="flex items-center justify-between mb-2">
    <span class="text-sm text-white/60"><%= view.chunks.size %> chunks · <%= view.candidates_evaluated %> candidatos evaluados</span>
  </div>
  <div class="rounded-md border border-white/10 overflow-hidden">
    <table class="w-full text-sm">
      <thead class="bg-ink/40 text-white/70">
        <tr>
          <th class="text-left p-3 font-bold tracking-tight">id</th>
          <th class="text-left p-3 font-bold tracking-tight">Contenido</th>
          <th class="text-left p-3 font-bold tracking-tight">Sector</th>
          <th class="text-right p-3 font-bold tracking-tight">Año</th>
          <th class="text-right p-3 font-bold tracking-tight">Distancia</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-white/10">
        <% view.chunks.each do |chunk| %>
          <tr>
            <td class="p-3 align-top font-mono text-white/80"><%= chunk.id %></td>
            <td class="p-3 align-top text-white/80"><%= truncate(chunk.content, length: 140) %></td>
            <td class="p-3 align-top">
              <span class="inline-block bg-ink/60 text-white/80 rounded px-2 py-0.5 text-xs"><%= chunk.sector %></span>
              <span class="text-white/40 text-xs block mt-1"><%= chunk.chunk_type %></span>
            </td>
            <td class="p-3 text-right align-top text-white/80 tabular-nums"><%= chunk.project_year %></td>
            <td class="p-3 text-right align-top text-white/90 tabular-nums"><%= number_with_precision(chunk.distance, precision: 4) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="mt-6">
    <%= link_to "Continuar → Augmentation", rag_estimation_run_path(run, step: "augmentation"),
          class: "inline-flex items-center px-5 py-2.5 bg-brand text-ink-dark font-bold tracking-tight rounded-md hover:bg-brand-strong transition-colors text-sm" %>
  </div>
<% end %>
