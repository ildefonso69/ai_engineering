<% generation = run.generation_view %>
<% original = generation&.estimate %>
<% modules = run.adjusted_modules %>

<h2 class="text-lg font-bold tracking-tight text-white mb-1">5 · Verificación humana</h2>
<p class="text-white/50 text-sm mb-5">
  La estimación del LLM es un punto de partida, no la última palabra. Ajusta cada tarea, añade o
  elimina tareas y módulos; los subtotales por módulo y el total se recalculan al vuelo. Al guardar
  queda una versión verificada junto a la original del modelo.
</p>

<% if original.nil? %>
  <div class="p-4 rounded-md bg-brand/15 border border-brand text-brand-soft">
    Aún no hay estimación generada. Vuelve a <%= link_to "Generación", rag_estimation_run_path(run, step: "generation"), class: "underline font-bold" %>.
  </div>
<% else %>
  <% if run.adjusted? && run.adjusted_breakdown["adjusted_at"].present? %>
    <div class="p-3 rounded-md bg-success/15 border border-success/40 text-success-light text-sm mb-5">
      ✓ Verificada el <%= run.adjusted_breakdown["adjusted_at"] %> · total humano:
      <span class="font-bold"><%= run.adjusted_total %></span> eng-días
      <span class="text-white/40">(original LLM: <%= original.total_engineer_days || original.recompute_total %>)</span>
    </div>
  <% end %>

  <div data-controller="estimate-modules-editor">
    <%= form_with url: verify_rag_estimation_run_path(run), method: :patch, local: true do %>
      <div data-estimate-modules-editor-target="modulesContainer">
        <% modules.each_with_index do |mod, m| %>
          <%= render "editable_module", m: m, mod: mod, tasks: mod.tasks.each_with_index.map { |task, t| [ t, task ] } %>
        <% end %>
      </div>

      <p data-estimate-modules-editor-target="empty" class="<%= "hidden" if modules.any? %> p-4 text-white/40 text-sm">
        Sin módulos. Añade bloques funcionales con «+ Añadir módulo».
      </p>

      <div class="flex items-center justify-between mt-2 mb-4">
        <button type="button" data-action="estimate-modules-editor#addModule"
                class="text-brand font-bold hover:text-brand-soft tracking-tight text-sm cursor-pointer">
          + Añadir módulo
        </button>
        <div class="text-sm text-white/70">
          Total: <span class="text-white font-bold tabular-nums text-lg" data-estimate-modules-editor-target="total">0</span>
          <span class="text-white/50">eng-días</span>
        </div>
      </div>

      <input type="hidden" name="total_engineer_days" data-estimate-modules-editor-target="totalField">

      <button type="submit"
              class="inline-flex items-center px-5 py-2.5 bg-brand text-ink-dark font-bold tracking-tight rounded-md hover:bg-brand-strong cursor-pointer transition-colors text-sm">
        Guardar estimación verificada
      </button>

      <%# Templates cloned by the Stimulus editor (placeholders __MIDX__/__TIDX__). %>
      <template data-estimate-modules-editor-target="moduleTemplate">
        <%= render "editable_module", m: "__MIDX__", mod: nil, tasks: [] %>
      </template>
      <template data-estimate-modules-editor-target="taskTemplate">
        <%= render "editable_task", m: "__MIDX__", t: "__TIDX__", task: nil %>
      </template>
    <% end %>
  </div>

  <%# The immutable LLM original, for side-by-side comparison. %>
  <details class="rounded-md border border-white/10 bg-ink/20 p-4 mt-6">
    <summary class="text-xs uppercase tracking-tight text-white/50 font-bold cursor-pointer">
      Original del LLM (solo lectura)
    </summary>
    <% original.modules.each do |mod| %>
      <div class="mt-3">
        <div class="flex items-center justify-between">
          <span class="font-bold text-white/90"><%= mod.name %></span>
          <span class="text-white/50 tabular-nums text-sm"><%= mod.subtotal %> d</span>
        </div>
        <ul class="mt-1 ml-3 text-sm text-white/70 list-disc list-inside">
          <% mod.tasks.each do |task| %>
            <li><%= task.name %> — <span class="tabular-nums"><%= task.engineer_days %> d</span>
              <% if task.sources.any? %><span class="text-white/40 font-mono text-xs">(<%= task.sources_label %>)</span><% end %>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>
    <% if original.modules.empty? %>
      <p class="mt-2 text-white/40 text-sm">Sin módulos (estimación insuficiente).</p>
    <% end %>
  </details>
<% end %>
