# Root-level orchestration variables - used for ${VAR} substitution by the
# ROOT docker-compose.yml only. Copy to .env at the repo root and fill in.
#
# This does NOT replace each subproject's own env file: estimator/.env still
# carries estimator's LLM keys etc. (loaded via env_file: - estimator/.env in
# the root compose file) and estimator-web's own env vars are already
# hardcoded in estimator-web/docker-compose.yml's environment: block. Real
# per-service values still live in estimator/.env (see
# estimator/app/config.py for the full Settings list) and are NOT duplicated
# here.

# Service-to-service auth token (Session 15). Shared secret known only to
# estimator-web and estimator - must be identical on both sides. The root
# compose file injects it into both services' environment from this one var.
# estimator: checked by app/api/security.py::require_service_token on
#   POST /api/v1/estimate (header X-Service-Token). Unset = check disabled
#   (keeps existing dev/test flows working outside docker-compose).
# estimator-web: sent by app/services/estimator_ai/estimations_client.rb.
AI_SERVICE_TOKEN=
