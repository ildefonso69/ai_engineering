# =============================================================================
# Proyecto 2 — variables de entorno (Sesión 15)
# =============================================================================
# Plantilla del .env que consume `docker compose` en la RAÍZ del repo. Se
# versiona SIN valores reales; el .env con los valores de verdad está en
# .gitignore y no debe subirse nunca.
#
#     cp .env.example .env
#     # rellena OPENAI_API_KEY y AI_SERVICE_TOKEN
#     docker compose up --build
#
# Compose usa este fichero de dos formas distintas (conviene no confundirlas):
#   1. Interpolación: los `${VAR}` del docker-compose.yml se sustituyen con
#      estos valores ANTES de crear los contenedores.
#   2. `env_file:`: las variables se inyectan DENTRO de los contenedores de
#      business-backend y ai-service, que es como las leen Rails y pydantic.
#
# Los ficheros ai-service/.env y business-backend/.env siguen existiendo para
# ejecutar cada servicio en solitario fuera de Docker (uv run uvicorn / bin/dev).
# El que manda en Docker es ESTE.


# -----------------------------------------------------------------------------
# Proveedores LLM — al menos uno es obligatorio
# -----------------------------------------------------------------------------
# El servicio IA aborta al arrancar si no hay ninguna de las dos.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=


# -----------------------------------------------------------------------------
# Autenticación entre servicios (Sesión 15)
# -----------------------------------------------------------------------------
# Token compartido backend de negocio → servicio IA, cabecera `X-Service-Token`.
# Protege TODA la superficie del servicio IA salvo /health (que debe quedar
# libre para que funcione el healthcheck de Docker) y /docs.
#
# Estar dentro de la red interna no es credencial suficiente: si un tercer
# contenedor entra en la red, sin token no llega a ningún endpoint.
#
# Si se deja VACÍO el middleware queda desactivado (útil para tests y para
# desarrollo en local). En cualquier despliegue real, ponle un valor.
# Genera uno con:  openssl rand -hex 32
AI_SERVICE_TOKEN=change-me

# Claves por router de la S9 (cabecera `X-API-Key`), independientes del token de
# servicio: son la segunda capa, que distingue QUÉ puede hacer quien ya entró.
# Vacías ⇒ esos routers responden 401 a todo.
RETRIEVAL_API_KEY=demo-retrieval-key
ESTIMATE_API_KEY=demo-estimate-key


# -----------------------------------------------------------------------------
# Base de datos relacional (backend de negocio)
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=estimator_web_development


# -----------------------------------------------------------------------------
# Base de datos vectorial (servicio IA — pgvector)
# -----------------------------------------------------------------------------
# Mismo motor Postgres con la extensión pgvector: los embeddings viven en una
# columna `vector` junto a los datos relacionales del servicio IA.
# El docker-compose.yml compone el DATABASE_URL completo a partir de estas tres.
VECTOR_DB_USER=estimator
VECTOR_DB_PASSWORD=estimator
VECTOR_DB_NAME=estimator


# -----------------------------------------------------------------------------
# Cómo se ven los servicios entre sí (DNS interno de compose)
# -----------------------------------------------------------------------------
# Dentro de compose cada servicio se resuelve por su NOMBRE DE SERVICIO, no por
# localhost: dentro de un contenedor, localhost es ese mismo contenedor.
# docker-compose.yml ya fija estos valores; se listan aquí por claridad.
ESTIMATOR_API_BASE_URL=http://ai-service:8000
ESTIMATOR_AI_TIMEOUT=180
REDIS_URL=redis://redis:6379


# -----------------------------------------------------------------------------
# Modelos (los más habituales; el resto conserva sus defaults en config.py)
# -----------------------------------------------------------------------------
PRIMARY_MODEL=gpt-4o-mini
FALLBACK_MODEL=claude-haiku-4-5-20251001
EMBEDDING_MODEL=text-embedding-3-small

# Deadline por llamada al modelo, en segundos, con LLM_RETRIES reintentos.
#
# NO LO BORRES. El default de config.py es 30, y 30 s bastan de sobra para
# gpt-4o-mini pero NO para la generación con razonamiento del pipeline RAG
# (GENERATION_MODEL=gpt-5, esfuerzo alto, 64k de presupuesto), que tarda entre
# uno y tres minutos. Sin esta línea, `POST /v1/estimate/from-transcript` falla
# SIEMPRE con un 502 tras 3 intentos de 30 s — 91 segundos de espera y de gasto
# para no obtener nada. Se descubrió ejecutando el golden set de la S16 contra
# la instancia; el smoke test no lo veía porque no llama al modelo.
LLM_TIMEOUT=600
LLM_RETRIES=2


# -----------------------------------------------------------------------------
# Entorno
# -----------------------------------------------------------------------------
# `production` conmuta structlog a JSON. RAILS_ENV lo fija el compose.
APP_ENV=development
LOG_LEVEL=INFO

# Observabilidad (S13). Sin token, los spans se generan pero no se exportan;
# nunca rompe el arranque.
# LOGFIRE_TOKEN=
LOGFIRE_SERVICE_NAME=estimator


# -----------------------------------------------------------------------------
# Despliegue (S15 · directo) — solo se usan en la EC2, no en el compose local
# -----------------------------------------------------------------------------
# En la instancia este fichero vive en /opt/estimator/.env con permisos 600 y
# NUNCA viene de git: se copia con scp una sola vez. El pipeline no lo conoce;
# solo tiene una clave SSH y un hostname.

# El dominio del que Caddy pedirá el certificado. Requiere un registro A que
# apunte a la IP elástica y esté propagado ANTES del primer arranque:
# Let's Encrypt no emite certificados para *.amazonaws.com.
# APP_DOMAIN=estimator.tu-dominio.com

# De dónde se descargan las imágenes que construye CI.
# IMAGE_OWNER=<tu-usuario-de-github>
# IMAGE_REGISTRY=ghcr.io
# IMAGE_TAG=latest          # el pipeline lo fija al SHA del commit desplegado

# Firma las cookies de Rails. Genéralo con: openssl rand -hex 64
# Si cambia, se invalidan todas las sesiones.
# SECRET_KEY_BASE=

# Aplica `alembic upgrade head` (servicio IA) y `db:prepare` (Rails) al arrancar.
# Ponlo a false en todas las réplicas menos una: no quieres dos migrando a la vez.
RUN_MIGRATIONS=true

# Nombre de proyecto de compose. Es LOAD-BEARING: compose deriva de él el nombre
# de los volúmenes. Si cambia, `estimator_postgres_data` resuelve a otro volumen
# VACÍO y el corpus desaparece en silencio. En la instancia lo fija systemd.
# COMPOSE_PROJECT_NAME=estimator
